# Docker Compose
BACKEND_IMAGE=ghcr.io/airsss993/histproject-backend:latest
PUBLIC_ADDRESS=:80
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=histproject

# New API: cmd/api
APP_ENV=development
SERVER_ADDRESS=:7666
SHUTDOWN_TIMEOUT=10s
MIGRATION_TIMEOUT=2m
SESSION_TTL=12h

# Initial super admin: cmd/bootstrap-admin
BOOTSTRAP_ADMIN_LOGIN=root
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_EMAIL=

# PostgreSQL
DATABASE_URL=postgres://postgres:change-me@db:5432/histproject?sslmode=disable

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=histproject
MINIO_SECRET_KEY=change-me
MINIO_ARCHIVE_BUCKET=archives
MINIO_SITE_BUCKET=sites
MINIO_USE_SSL=false
MAX_UPLOAD_BYTES=20971520
MAX_EXTRACTED_BYTES=209715200
MAX_ARCHIVE_FILES=2000
MAX_ARCHIVE_FILE_BYTES=52428800

# Site worker
CHROME_URL=http://localhost:9222
SCREENSHOT_TIMEOUT=60s
SITE_RENDER_BASE_URL=http://localhost:9000/sites
SITE_PREVIEW_BASE_URL=http://localhost:8080/preview
SITE_PUBLIC_BASE_URL=http://localhost:8080/sites

# Notifications
POSTBOX_SMTP_ADDRESS=postbox.cloud.yandex.net:587
POSTBOX_KEY_ID=
POSTBOX_SECRET=
EMAIL_FROM=info@russia-heroes.ru
ADMIN_PANEL_URL=http://localhost:3000/admin
NOTIFICATION_TIMEOUT=10s

# HTTP
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
