# App
SERVER_PORT=":port"
CLAMAV_ENABLED=false
CLAMAV_HOST=
CHROME_URL=
MAX_UPLOAD_MB=350

# PostgreSQL
# APP_ENV=dev/prod — выбирает соответствующий DSN; если не указан, используется PG_DSN
APP_ENV=
PG_DSN=
PG_DSN_DEV=
PG_DSN_PROD=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# MinIO
MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=
SITE_PUBLIC_URL=

# Redis
REDIS_ADDRESS=
REDIS_PASSWORD=
REDIS_DB=

# Auth
JWT_SECRET=
# Оставить пустым для локальной разработки.
COOKIE_DOMAIN=

# Cors
CORS_ALLOWED_ORIGINS=

RESEND_API_KEY=
EMAIL_FROM=info@mail.russia-heroes.ru
ADMIN_PANEL_URL=

# Telegram (уведомления в группу администраторов)
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=