# New API: cmd/api
APP_ENV=development
SERVER_ADDRESS=:7666
SHUTDOWN_TIMEOUT=10s
MIGRATION_TIMEOUT=2m
SESSION_TTL=12h

# Initial super admin: cmd/bootstrap-admin
BOOTSTRAP_ADMIN_LOGIN=root
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_EMAIL=

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/histproject?sslmode=disable

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=histproject
MINIO_SECRET_KEY=change-me
MINIO_ARCHIVE_BUCKET=requests
MINIO_SITE_BUCKET=sites
MINIO_USE_SSL=false
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACTED_BYTES=209715200
MAX_ARCHIVE_FILES=2000
MAX_ARCHIVE_FILE_BYTES=52428800

# Site worker
CHROME_URL=http://localhost:9222
SCREENSHOT_TIMEOUT=60s
SITE_RENDER_BASE_URL=http://localhost:9000/sites
SITE_PREVIEW_BASE_URL=http://localhost/preview
SITE_PUBLIC_BASE_URL=http://localhost/sites

# Notifications
RESEND_API_KEY=
EMAIL_FROM=
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
ADMIN_PANEL_URL=http://localhost:3000/admin
NOTIFICATION_TIMEOUT=10s

# HTTP
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Legacy API: cmd/main.go. Remove after Docker switches to cmd/api.
SERVER_PORT=7666
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav:3310
CHROME_URL=http://chrome:9222
MAX_UPLOAD_MB=50
PG_DSN=postgres://postgres:postgres@localhost:5432/histproject?sslmode=disable
PG_DSN_DEV=postgres://postgres:postgres@localhost:5432/histproject?sslmode=disable
PG_DSN_PROD=postgres://postgres:postgres@db:5432/histproject?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=histproject
POSTGRES_HOST=db
POSTGRES_PORT=5432
MINIO_ROOT_USER=histproject
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET_NAME=histproject
MINIO_PUBLIC_URL=http://localhost:9010
SITE_PUBLIC_URL=http://localhost
JWT_SECRET=change-me
