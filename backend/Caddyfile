{$PUBLIC_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:7666
	}

	handle /healthz {
		reverse_proxy api:7666
	}

	handle /readyz {
		reverse_proxy api:7666
	}

	handle_path /preview/* {
		forward_auth api:7666 {
			uri /api/v1/auth/session
		}
		rewrite * /sites{path}
		reverse_proxy minio:9000
	}

	handle /sites/* {
		reverse_proxy minio:9000
	}

	respond "Not found" 404
}
